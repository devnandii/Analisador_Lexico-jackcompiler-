\ No newline at end of file
+
+    private static String toXml(List<Token> tokens) {
+        StringBuilder result = new StringBuilder("<tokens>\n");
+        for (Token token : tokens) result.append(token.toXmlLine()).append('\n');
+        return result.append("</tokens>\n").toString();
+    }
+
+    private static String toText(List<Token> tokens) {
+        StringBuilder result = new StringBuilder();
+        for (Token token : tokens) result.append(token).append('\n');
+        return result.toString();
+    }
+
+    private static void usage(String error) {
+        if (error != null) System.err.println(error);
+        System.err.println("Uso: java -cp bin Main [--xml] [-o arquivo-saida] <arquivo.jack>");
+        System.err.println("  --xml              gera XML no formato nand2tetris");
+        System.err.println("  -o, --output ARQ   grava a saída no arquivo indicado");
+    }
